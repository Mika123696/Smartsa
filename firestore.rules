rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function hasUserDoc() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isVerifiedEmail() {
      return isSignedIn() && ('email' in request.auth.token) && request.auth.token.email is string;
    }

    function isInstitutionalAdminEmail() {
      return isVerifiedEmail() && request.auth.token.email.matches('(?i)^admin(\\.[^@]+)?@smartsa\\.edu$');
    }

    function isInstitutionalLecturerEmail() {
      return isVerifiedEmail() && request.auth.token.email.matches('(?i)^dosen(\\.[^@]+)?@smartsa\\.edu$');
    }

    function userRole() {
      return ('role' in request.auth.token && request.auth.token.role != null)
        ? request.auth.token.role
        : (isInstitutionalAdminEmail()
          ? 'admin'
          : (isInstitutionalLecturerEmail()
            ? 'lecturer'
            : (hasUserDoc() ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role : null)));
    }

    function isAdmin() {
      return isSignedIn() && userRole() == 'admin';
    }

    function isLecturer() {
      return isSignedIn() && userRole() == 'lecturer';
    }

    function isLecturerOrAdmin() {
      return isLecturer() || isAdmin();
    }

    function isClassMember(classId, uid) {
      return exists(/databases/$(database)/documents/class_members/$(classId + '_' + uid))
        && get(/databases/$(database)/documents/class_members/$(classId + '_' + uid)).data.get('status', 'approved') in ['approved', 'active'];
    }

    function isClassLecturer(classId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/classes/$(classId))
        && get(/databases/$(database)/documents/classes/$(classId)).data.lecturerId == request.auth.uid;
    }

    // 1. users/{uid} (role, accountType, isInstitutional dikelola server via /api/bootstrap Admin SDK)
    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if isSignedIn()
        && request.auth.uid == uid
        && !('password' in request.resource.data)
        && !('accountType' in request.resource.data)
        && !('isInstitutional' in request.resource.data)
        && (!('role' in request.resource.data) || request.resource.data.role == 'student');
      allow update: if (isSignedIn()
        && request.auth.uid == uid
        && !('password' in request.resource.data)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'nim', 'nidn', 'password'])
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['accountType', 'isInstitutional', 'emailVerified', 'nip']))
        || (isAdmin() && !('password' in request.resource.data));
      allow delete: if false;
    }

    // 2. classes/{classId}
    match /classes/{classId} {
      allow read: if isAdmin()
        || resource.data.isPublic == true
        || (isSignedIn() && (
          resource.data.lecturerId == request.auth.uid
          || isClassMember(classId, request.auth.uid)
        ));
      allow create: if isAdmin()
        || (isLecturer() && request.resource.data.lecturerId == request.auth.uid);
      allow update: if isAdmin()
        || (
          isLecturer()
          && resource.data.lecturerId == request.auth.uid
          && request.resource.data.lecturerId == resource.data.lecturerId
        );
      allow delete: if isAdmin()
        || (isLecturer() && resource.data.lecturerId == request.auth.uid);
    }

    // 3. class_members/{classId}_{uid} (dikelola server-side via /api/join-class Admin SDK)
    match /class_members/{memberId} {
      allow read: if isSignedIn() && (
        resource.data.uid == request.auth.uid
        || isAdmin()
        || (resource.data.classId is string && isClassLecturer(resource.data.classId))
      );
      allow create, update, delete: if false;
    }

    // 4. attendance/{classId}_m{meetingNo}_{uid}
    match /attendance/{attendanceId} {
      allow read: if isAdmin() || (
        isSignedIn() && (
          resource.data.uid == request.auth.uid
          || (resource.data.classId is string && isClassLecturer(resource.data.classId))
        )
      );
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.classId is string
        && request.resource.data.meetingNo is int
        && request.resource.data.meetingNo >= 1
        && request.resource.data.meetingNo <= 32
        && attendanceId == (request.resource.data.classId + '_m' + string(request.resource.data.meetingNo) + '_' + request.auth.uid)
        && isClassMember(request.resource.data.classId, request.auth.uid);
      allow update, delete: if isAdmin()
        || (isLecturer() && resource.data.classId is string && isClassLecturer(resource.data.classId));
    }

    // 5. assignments/{assignmentId}
    match /assignments/{assignmentId} {
      allow read: if isAdmin() || (
        isSignedIn()
        && resource.data.classId is string
        && (
          isClassLecturer(resource.data.classId)
          || isClassMember(resource.data.classId, request.auth.uid)
        )
      );
      allow create: if isAdmin() || (
        isLecturer()
        && request.resource.data.classId is string
        && isClassLecturer(request.resource.data.classId)
      );
      allow update: if isAdmin() || (
        isLecturer()
        && resource.data.classId is string
        && isClassLecturer(resource.data.classId)
        && request.resource.data.classId == resource.data.classId
      );
      allow delete: if isAdmin() || (
        isLecturer()
        && resource.data.classId is string
        && isClassLecturer(resource.data.classId)
      );
    }

    // 6. submissions/{assignmentId}_{uid}
    match /submissions/{submissionId} {
      allow read: if isAdmin() || (
        isSignedIn() && (
          resource.data.uid == request.auth.uid
          || (resource.data.classId is string && isClassLecturer(resource.data.classId))
        )
      );
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.assignmentId is string
        && request.resource.data.classId is string
        && isClassMember(request.resource.data.classId, request.auth.uid)
        && submissionId == (request.resource.data.assignmentId + '_' + request.auth.uid)
        && !request.resource.data.keys().hasAny(['grade', 'score', 'feedback', 'gradedBy']);
      allow update: if isAdmin()
        || (isLecturer() && resource.data.classId is string && isClassLecturer(resource.data.classId))
        || (
          isSignedIn()
          && resource.data.uid == request.auth.uid
          && submissionId == (resource.data.assignmentId + '_' + request.auth.uid)
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['grade', 'score', 'feedback', 'gradedBy', 'uid', 'assignmentId', 'classId'])
        );
      allow delete: if isAdmin() || (
        isSignedIn()
        && resource.data.uid == request.auth.uid
        && !('grade' in resource.data && resource.data.grade != null)
        && !('score' in resource.data && resource.data.score != null)
      );
    }

    // 7. exam_attempts/{classId}_m{meetingNo}_{examType}_{uid} (dikelola server-side via /api/grade Admin SDK)
    match /exam_attempts/{attemptId} {
      allow read: if isAdmin() || (
        isSignedIn() && (
          resource.data.uid == request.auth.uid
          || (resource.data.classId is string && isClassLecturer(resource.data.classId))
        )
      );
      allow create, update, delete: if false;
    }

    // 7b. exams/{classId}_m{meetingNo}_{examType} (soal bebas kunci; ditulis server-side via /api/grade)
    match /exams/{examId} {
      allow get: if isSignedIn() && (
        resource == null
        || isAdmin()
        || (resource.data.classId is string && (
          isClassLecturer(resource.data.classId)
          || isClassMember(resource.data.classId, request.auth.uid)
        ))
      );
      allow list: if isAdmin() || (
        isSignedIn()
        && resource.data.classId is string
        && (
          isClassLecturer(resource.data.classId)
          || isClassMember(resource.data.classId, request.auth.uid)
        )
      );
      allow create, update, delete: if false;
    }

    // 8. exam_keys/{classId} (strictly server-only)
    match /exam_keys/{classId} {
      allow read, write: if false;
    }

    // 9. discussions/{discussionId}
    function isValidMemberLikeUpdate(oldData, newData) {
      let oldLiked = oldData.get('likedBy', []);
      let newLiked = newData.likedBy;
      return newLiked is list
        && newData.likes is int
        && newData.likes == newLiked.size()
        && newLiked.removeAll(oldLiked).hasOnly([request.auth.uid])
        && oldLiked.removeAll(newLiked).hasOnly([request.auth.uid]);
    }

    function isValidMemberReplyAdd(oldReplies, newReplies) {
      return newReplies is list
        && newReplies.size() == oldReplies.size() + 1
        && newReplies.size() > 0
        && oldReplies + [newReplies[oldReplies.size()]] == newReplies
        && newReplies[oldReplies.size()] is map
        && newReplies[oldReplies.size()].get('authorUid', '') == request.auth.uid
        && newReplies[oldReplies.size()].get('content', '') is string
        && newReplies[oldReplies.size()].get('content', '').size() > 0;
    }

    function isValidMemberReplyEdit(oldReplies, newReplies) {
      let removed = oldReplies.removeAll(newReplies);
      let added = newReplies.removeAll(oldReplies);
      return newReplies is list
        && newReplies.size() == oldReplies.size()
        && removed.size() == 1
        && added.size() == 1
        && removed[0] is map
        && added[0] is map
        && removed[0].get('authorUid', '') == request.auth.uid
        && added[0].get('authorUid', '') == request.auth.uid
        && added[0].get('id', '') == removed[0].get('id', '')
        && added[0].get('content', '') is string
        && added[0].get('content', '').size() > 0;
    }

    function isValidMemberReplyDelete(oldReplies, newReplies) {
      let removed = oldReplies.removeAll(newReplies);
      let added = newReplies.removeAll(oldReplies);
      return newReplies is list
        && newReplies.size() + 1 == oldReplies.size()
        && removed.size() == 1
        && added.size() == 0
        && removed[0] is map
        && removed[0].get('authorUid', '') == request.auth.uid;
    }

    match /discussions/{discussionId} {
      allow read: if isAdmin() || (
        isSignedIn()
        && resource.data.classId is string
        && (
          isClassLecturer(resource.data.classId)
          || isClassMember(resource.data.classId, request.auth.uid)
        )
      );
      allow create: if isSignedIn()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.classId is string
        && (
          isAdmin()
          || isClassLecturer(request.resource.data.classId)
          || isClassMember(request.resource.data.classId, request.auth.uid)
        )
        && request.resource.data.get('isVerifiedAnswer', false) == false;
      allow update: if isSignedIn()
        && resource.data.classId is string
        && (
          isAdmin()
          || isClassLecturer(resource.data.classId)
          || (
            isClassMember(resource.data.classId, request.auth.uid)
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
              'isVerifiedAnswer',
              'verifiedBy',
              'verifiedReplyId',
              'classId',
              'authorUid',
              'meetingNo',
              'createdAt'
            ])
            && (
              (
                resource.data.authorUid == request.auth.uid
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['content', 'editedAt', 'updatedAt'])
                && request.resource.data.content is string
                && request.resource.data.content.size() > 0
              )
              || (
                request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'likedBy', 'updatedAt'])
                && isValidMemberLikeUpdate(resource.data, request.resource.data)
              )
              || (
                request.resource.data.diff(resource.data).affectedKeys().hasOnly(['replies', 'updatedAt'])
                && (
                  isValidMemberReplyAdd(resource.data.get('replies', []), request.resource.data.replies)
                  || isValidMemberReplyEdit(resource.data.get('replies', []), request.resource.data.replies)
                  || isValidMemberReplyDelete(resource.data.get('replies', []), request.resource.data.replies)
                )
              )
            )
          )
        );
      allow delete: if isAdmin() || (
        isSignedIn()
        && resource.data.classId is string
        && (
          resource.data.authorUid == request.auth.uid
          || isClassLecturer(resource.data.classId)
        )
      );
    }

    // 10. learning_progress/{classId}_m{meetingNo}_{uid}
    match /learning_progress/{progressId} {
      allow read: if isAdmin() || (
        isSignedIn() && (
          resource.data.uid == request.auth.uid
          || (resource.data.classId is string && isClassLecturer(resource.data.classId))
        )
      );
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.classId is string
        && isClassMember(request.resource.data.classId, request.auth.uid)
        && request.resource.data.meetingNo is int
        && request.resource.data.meetingNo >= 1
        && request.resource.data.meetingNo <= 32
        && progressId == (request.resource.data.classId + '_m' + string(request.resource.data.meetingNo) + '_' + request.auth.uid);
      allow update: if isSignedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.classId == resource.data.classId
        && request.resource.data.meetingNo == resource.data.meetingNo
        && progressId == (resource.data.classId + '_m' + string(resource.data.meetingNo) + '_' + request.auth.uid);
      allow delete: if isAdmin();
    }

    // 11. rate_limits/{scope}_{uid} (strictly server-only via Admin SDK)
    match /rate_limits/{rateLimitId} {
      allow read, write: if false;
    }
  }
}

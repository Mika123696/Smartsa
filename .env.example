# ===================================================================
# Smartsa LMS — Environment Variables Configuration Template
# ===================================================================

# --- 1. Client Firebase Configuration (src/firebase.js) ---
# Wajib diisi di Vercel atau file .env lokal untuk mengaktifkan Firebase Auth & Cloud Firestore.
# Jika kosong, aplikasi otomatis berjalan pada Demo Mode tanpa error startup.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- 2. Firebase Admin SDK (api/index.js & scripts/*.mjs) ---
# Pilih salah satu metode kredensial server-side di bawah ini:
# Opsi A: JSON lengkap Service Account (satu baris)
FIREBASE_SERVICE_ACCOUNT_KEY=
# Opsi B: Field terpisah Service Account (direkomendasikan untuk Vercel Environment Variables)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Opsi C: Path file JSON lokal untuk CLI scripts (scripts/sanitize-users.mjs, dll.)
GOOGLE_APPLICATION_CREDENTIALS=

# --- 3. Cloudinary CDN & Signed Uploads (api/index.js -> /api/upload-sign) ---
# Seluruh kredensial Cloudinary dikelola di server; client hanya meminta signature bertoken.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Opsional: referensi nama cloud publik jika dibutuhkan oleh komponen pratinjau klien
VITE_CLOUDINARY_CLOUD_NAME=

# --- 4. Google Gemini AI (api/index.js -> /api/ai) [Opsional / Ditunda] ---
# Biarkan kosong untuk menjalankan Mode Asisten Lokal (local_frozen).
# Dilarang memberi prefix VITE_ agar API key tidak terekspos di client bundle.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

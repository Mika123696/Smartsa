# ===================================================================
# Smartsa LMS — Environment Variables Configuration Template
# ===================================================================

# --- 1. Client Firebase Configuration (Otomatis / Fallback Tersedia) ---
# Di Vercel atau file .env lokal, variabel ini dapat diisi dengan konfigurasi project Anda:
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- 2. Google Gemini AI (Backend Serverless Vercel) ---
# Kunci rahasia API Google Gemini untuk orkestrasi Learning Assistant & Teaching Assistant.
# Dilarang memasukkan variabel ini dengan prefix VITE_ atau mengeksposnya ke client-side bundle.
GEMINI_API_KEY=

# --- 3. Cloudinary CDN & Signed Uploads ---
# Kredensial akun Cloudinary untuk penyimpanan foto, materi gambar, dan dokumen Manual Book.
# Hanya CLOUD_NAME yang boleh bersifat publik jika dibutuhkan; API_KEY & SECRET wajib server-only.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- 4. Nodemailer / SMTP Gateway (Multi-Factor Authentication OTP) ---
# Kredensial server SMTP untuk pengiriman kode verifikasi 6 digit ke email pengguna.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Smartsa LMS <noreply@smartsa.edu>"

